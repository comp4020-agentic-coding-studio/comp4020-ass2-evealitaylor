---
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import SessionsGrid from "../../components/SessionsGrid.astro";
import { sessionLabels, siteConfig } from "../../site-config";
---

<ContentLayout
  title={sessionLabels.plural}
  description={`The twelve-week teaching schedule: what happens in each ${sessionLabels.singular.toLowerCase()}, what to prepare, and what leaves the room.`}
  {...siteConfig}
>
  <p>
    Twelve rostered Shifts, two hours each. They are called Shifts rather than
    tutorials because that is what the work is: from week 8 there is a live
    queue on the course sandbox, and it does not clear itself between classes.
  </p>
  <p>
    Every Shift page says what to bring, what happens in the room, and what
    leaves it. The last of those is the one to read first &mdash; from week 2
    onward, whatever a Shift produces is what your Contribution Log is made of.
  </p>
  <SessionsGrid />
</ContentLayout>
